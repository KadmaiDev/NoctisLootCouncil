# Copy to .env and fill in. Turn on Developer Mode in Discord (Settings > Advanced) to copy IDs
# with a right-click.

# Bot token from the Discord developer portal (Bot tab > Reset Token)
DISCORD_TOKEN=
# Your server's ID (right-click the server icon > Copy Server ID)
GUILD_ID=
# The officers' role: only this role can vote, set priorities and use the officer commands
OFFICER_ROLE_ID=

# Channel IDs (right-click a channel > Copy Channel ID)
CHANNEL_LOOT_OFFICERS=
CHANNEL_LOOT_ITEMS=
CHANNEL_LOOT_PRIORITIES=
CHANNEL_LOOT_LOG=

# Optional: the channel the game's guild chat link posts in. The bot deletes its "has not yet linked
# their Discord account" lines there. Turn on Message Content Intent first (Bot tab of the
# application, or the bot can't connect) and give the bot Manage Messages in that channel.
CHANNEL_IN_GAME_CHAT=

# The HTTP API for the companion app. Keep it on 127.0.0.1 behind your reverse proxy;
# in Docker use 0.0.0.0 (the compose file publishes it on the host's 127.0.0.1 only).
API_HOST=127.0.0.1
API_PORT=8080

# Votes an option needs to decide an item (and it must have more than the other option)
VOTES_TO_DECIDE=3

# SQLite database, relative to the project folder unless absolute
DB_PATH=data/noctis-loot.db

# Raid nights and dates in posts use this time zone (a raid night runs until 06:00)
TIMEZONE=Europe/London

# Item icons and Wowhead links in posts: the bot looks each item up once on wowhead.com.
# 0 turns it off.
WOWHEAD_LOOKUP=1

# The companion app's update notice: about once an hour the bot asks GitHub for the newest
# companion release (github.com/KadmaiDev/NoctisLootCouncil) and tells companions about it.
# 0 turns it off.
RELEASE_CHECK=1

# Warcraft Logs, for /loot wcl (links a night's report on #loot-log): make a client on
# warcraftlogs.com > API clients (any redirect URL, not a public client). Blank leaves it off.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
